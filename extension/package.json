{
  "name": "vaultdraft",
  "description": "Capture and archive AI conversations into local Markdown or Notion.",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "postinstall": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "wxt build",
    "test:e2e": "playwright test",
    "zip": "wxt zip"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "minisearch": "^7.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.55.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^3.2.4",
    "@wxt-dev/module-react": "^1.1.5",
    "eslint": "^9.39.1",
    "fake-indexeddb": "^6.2.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4",
    "wxt": "^0.21.3"
  }
}
